# Deps & build artifacts (reinstalled/rebuilt inside the image)
node_modules
**/node_modules
.pnpm-store
.next
**/.next
dist
**/dist
out
**/out
.turbo
**/.turbo
*.tsbuildinfo

# Generated Prisma client (regenerated in the build stage)
**/src/generated/prisma

# VCS / editor / OS
.git
.gitignore
.idea
.vscode
**/.DS_Store

# Secrets — never bake into an image (matches nested too, e.g. packages/db/.env)
**/.env
**/.env.*

# Logs, coverage
*.log
coverage

# Heavy design assets not needed at runtime
docs/Gabee-handoff.zip
