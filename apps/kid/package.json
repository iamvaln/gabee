{
  "name": "@gabee/kid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "files=$(find src -name '*.test.ts'); if [ -z \"$files\" ]; then echo 'no unit test files found' >&2; exit 1; fi; node --import tsx --test $files",
    "test:dom": "files=$(find src -name '*.test.tsx'); if [ -z \"$files\" ]; then echo 'no DOM test files found' >&2; exit 1; fi; node --import tsx --test --test-force-exit $files",
    "test:coverage": "c8 -r text -r lcov -r html -x '**/*.test.*' -x 'src/test/**' pnpm run test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@gabee/types": "workspace:*",
    "@sentry/react": "^10.63.0",
    "@tanstack/react-query": "^5.100.14",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^26.3.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "c8": "^11.0.0",
    "fake-indexeddb": "^6.2.5",
    "global-jsdom": "^29.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
