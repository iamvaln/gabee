#!/bin/bash
# One-shot — POST the classification-digest endpoint and pretty-print the
# response. Exit 0 on HTTP 200, non-zero otherwise so the loop's logging
# can flag the failure.
set -euo pipefail

: "${CRON_DIGEST_URL:?CRON_DIGEST_URL is required (e.g. http://web:3000/api/cron/classification-digest)}"
: "${CRON_SECRET:?CRON_SECRET is required (shared with the web service)}"

echo "[digest] POST ${CRON_DIGEST_URL}"

# `--fail-with-body` prints the response on non-2xx then exits non-zero —
# both the body and the rc are visible in the loop log on failure.
response=$(
  curl --silent --show-error --fail-with-body \
    --max-time 60 \
    -X POST "${CRON_DIGEST_URL}" \
    -H "Authorization: Bearer ${CRON_SECRET}"
)
rc=$?

if [ "$rc" -ne 0 ]; then
  echo "[digest] FAILED (curl rc=$rc): ${response}" >&2
  exit "$rc"
fi

# Pretty-print the summary when jq's available; otherwise dump the raw body.
if command -v jq >/dev/null 2>&1; then
  echo "$response" | jq -c '.summary'
else
  echo "$response"
fi

# Secondary, best-effort: the weekly admin digest shares this daily cadence.
# The endpoint self-gates to one send per week, so a daily poke is a no-op on
# the other six days. A failure here NEVER changes this script's exit status —
# the primary classification run already succeeded; we just log and move on.
if [ -n "${ADMIN_DIGEST_URL:-}" ]; then
  echo "[digest] POST ${ADMIN_DIGEST_URL} (admin, best-effort)"
  if admin_resp=$(
    curl --silent --show-error --fail-with-body \
      --max-time 60 \
      -X POST "${ADMIN_DIGEST_URL}" \
      -H "Authorization: Bearer ${CRON_SECRET}"
  ); then
    if command -v jq >/dev/null 2>&1; then echo "$admin_resp" | jq -c '.summary'; else echo "$admin_resp"; fi
  else
    echo "[digest] admin poke FAILED (rc=$?): ${admin_resp:-}" >&2
  fi
fi

# Secondary, best-effort: purge raw device IPs past the retention window
# (privacy — see services/device-ip-retention.ts). Idempotent, so a daily poke
# is safe; on most days it deletes little or nothing. A failure here NEVER
# changes this script's exit status — we log and move on, same as the admin
# digest above. The response carries counts only, never an IP value.
if [ -n "${PURGE_IPS_URL:-}" ]; then
  echo "[digest] POST ${PURGE_IPS_URL} (ip-retention purge, best-effort)"
  if purge_resp=$(
    curl --silent --show-error --fail-with-body \
      --max-time 60 \
      -X POST "${PURGE_IPS_URL}" \
      -H "Authorization: Bearer ${CRON_SECRET}"
  ); then
    if command -v jq >/dev/null 2>&1; then echo "$purge_resp" | jq -c '.summary'; else echo "$purge_resp"; fi
  else
    echo "[digest] ip-retention purge FAILED (rc=$?): ${purge_resp:-}" >&2
  fi
fi
