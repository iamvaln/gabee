# ─── Database (Supabase Postgres, via Prisma) ────────────────────────────────
# Pooled connection (PgBouncer) for the app runtime
DATABASE_URL="postgresql://postgres:password@localhost:5432/gabee?schema=public"
# Direct connection for migrations (Supabase: the non-pooled URL)
DIRECT_URL="postgresql://postgres:password@localhost:5432/gabee?schema=public"

# ─── Supabase Auth ───────────────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Public (exposed to the browser) — Next.js web app
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Public — kid PWA (Vite)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_API_BASE_URL="https://api.gabee.app"

# ─── Email (Mailgun) ─────────────────────────────────────────────────────────
# EMAIL_PROVIDER is optional — when omitted the code auto-detects from the
# presence of MAILGUN_* (preferred) or RESEND_* env vars, falling back to
# `noop` (logs to stdout) when neither is set. Set explicitly to override.
# Accepted values: mailgun | resend | noop
# EMAIL_PROVIDER="mailgun"
MAILGUN_API_KEY="your-mailgun-api-key"
MAILGUN_DOMAIN="mg.gabee.app"
MAILGUN_FROM="Gabee <no-reply@gabee.app>"
# US (default) or EU region — match your Mailgun dashboard.
# MAILGUN_REGION="us"

# Recipient(s) for transactional admin notifications — comma-separated for
# multiple addresses. Today: landing contact-form submissions.
ADMIN_CONTACT_EMAIL="admin@gabee.app"

# ─── LLM (Claude — provider-abstracted, Phase 2 generation) ──────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ─── App origins (CORS / host-based routing) ─────────────────────────────────
KID_APP_ORIGIN="https://kids.gabee.app"

# Public-facing parent app URL. Used to mint absolute links in outbound
# emails (password reset, email confirmation, co-parent invite). When unset
# the app falls back to forwarded headers, then req.url — risky behind a
# reverse proxy in prod, so set this explicitly there.
PARENT_APP_URL="https://parents.gabee.app"

# ─── Cron sidecar shared secret ──────────────────────────────────────────────
# Shared secret used by the `cron-digest` sidecar to authenticate against
# /api/cron/*. Generate with: openssl rand -hex 32. When unset, the cron
# endpoints fail closed (503), so a misconfigured deploy doesn't silently
# run authless.
CRON_SECRET="dev-cron-secret-please-rotate-in-prod-with-openssl-rand-hex-32"

# ─── Database backups (Cloudflare R2) ────────────────────────────────────────
# The `backup` compose service runs a daily pg_dump (defaults to 03:00 UTC),
# gzips it, uploads to R2 via the S3-compatible API, then prunes anything
# older than the retention window. See docs/backups.md for the bucket
# setup + restore procedure.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="gabee-db-backups"
# Optional — key prefix inside the bucket. Defaults to "backups".
# R2_PREFIX="backups"
# Optional — hour of day (UTC) for the daily run. Defaults to 3 (03:00 UTC).
# BACKUP_SCHEDULE_HOUR_UTC="3"
# Optional — retention window in days. Defaults to 14.
# BACKUP_RETENTION_DAYS="14"
