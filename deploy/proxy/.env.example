# Email used by Let's Encrypt for expiry notices. Copy to `.env` and set it.
ACME_EMAIL=you@example.com

# Cloudflare API token — read only by the `le-dns` resolver (DNS-01), used for
# hostnames that sit behind Cloudflare's proxy. Scope it to Zone:DNS:Edit on
# those zones and nothing else. Leave empty if no host needs it: `le` keeps
# working on its own.
CF_DNS_API_TOKEN=
