# ─────────────────────────────────────────────────────────────────────────────
# Gabee — production env. Copy to `.env.production` on the VPS and fill in.
# NEVER commit the filled file. Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Domains (used by docker-compose + Traefik routing) ──
WEB_DOMAIN=gabee.app
KID_DOMAIN=kids.gabee.app

# ── PostgreSQL (the `db` service) ──
POSTGRES_USER=gabee
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=gabee

# ── Database URLs (host = `db`, the compose service name) ──
# Runtime (pg driver adapter) and migrations both target the same Postgres.
DATABASE_URL=postgresql://gabee:CHANGE_ME_strong_password@db:5432/gabee?schema=public
DIRECT_URL=postgresql://gabee:CHANGE_ME_strong_password@db:5432/gabee?schema=public

# ── Auth secrets (app-managed JWT — NOT Supabase) ──
AUTH_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
COPARENT_INVITE_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Cross-origin: the kid PWA origin the API accepts (CORS) ──
KID_APP_ORIGIN=https://kids.gabee.app
# Public URL of the kid app, inlined into the web build (build arg too).
NEXT_PUBLIC_KID_APP_URL=https://kids.gabee.app
# Public URL of the parent app, inlined into the landing build so its CTAs
# point at parents.gabee.app instead of /parent/* (the apex 404s those paths
# under host-isolation enforcement).
NEXT_PUBLIC_PARENT_APP_URL=https://parents.gabee.app
# API base URL the kid PWA calls, inlined into the kid build (build arg too).
VITE_API_BASE_URL=https://api.gabee.app
# Public-facing parent app URL — minted into outbound emails (reset password,
# email confirmation, co-parent invite). Behind Traefik `req.url` looks like
# localhost; setting this explicitly is the only fool-proof way to make
# email links point at the public host.
PARENT_APP_URL=https://parents.gabee.app

# ── Session-cookie scopes ──
# Two distinct cookies — `gabee_parent_session` and `gabee_admin_session` —
# so an admin login is never silently honoured by a parent surface. The
# `Domain` attribute on each scopes which subdomains the browser sends it
# to.
#   - `.gabee.app` (leading dot) → matches gabee.app + parents.gabee.app +
#     kids.gabee.app + every other subdomain.
#   - `admin.gabee.app` (exact)  → admin subdomain only.
# Leave empty in dev (single host).
COOKIE_DOMAIN_PARENT=.gabee.app
COOKIE_DOMAIN_ADMIN=admin.gabee.app

# ── LLM (content generation) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Email — optional; provider auto-detected from credentials, else no-op ──
# Force a provider with EMAIL_PROVIDER=mailgun|resend|noop (else: mailgun if its
# vars are set, resend if RESEND_API_KEY is set, otherwise noop = log only).
EMAIL_PROVIDER=
# From-address (falls back to MAILGUN_FROM, then a default).
EMAIL_FROM=
# Who receives contact-form / admin notifications.
ADMIN_CONTACT_EMAIL=
# Mailgun (requires API key + domain). Region eu → api.eu.mailgun.net.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=Gabee <no-reply@gabee.app>
MAILGUN_REGION=eu
MAILGUN_BASE_URL=https://api.eu.mailgun.net/v3
# Resend (alternative to Mailgun).
RESEND_API_KEY=

# ── Database backups (Cloudflare R2) ──
# The `backup` compose service runs a daily pg_dump (defaults to 03:00 UTC),
# gzips it, uploads to R2 via the S3-compatible API, then prunes anything
# older than the retention window. See docs/backups.md for bucket setup +
# restore procedure. If these are empty, the backup container will restart-
# loop with "R2_ENDPOINT is required" — set them or comment out the `backup`
# service in docker-compose.yml.
#
# R2_ENDPOINT looks like https://<account-id>.r2.cloudflarestorage.com — find
# the exact value under Cloudflare → R2 → bucket → Settings → S3 API endpoint.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gabee-db-backups
# Optional — key prefix inside the bucket. Defaults to "backups".
# R2_PREFIX=backups
# Optional — hour of day (UTC) for the daily run. Defaults to 3 (03:00 UTC).
# BACKUP_SCHEDULE_HOUR_UTC=3
# Optional — retention window in days. Defaults to 14.
# BACKUP_RETENTION_DAYS=14

# ── Cron (classification digest + future jobs) ──
# Shared secret between the `cron-digest` sidecar and the Next /api/cron/*
# endpoints. Generate with: openssl rand -hex 32. When unset, /api/cron/*
# fails closed (returns 503) — so a misconfigured prod doesn't silently
# run with no auth.
CRON_SECRET=
# Optional — hour of day (UTC) for the daily digest run. Defaults to 9 (09:00 UTC).
# CRON_DIGEST_HOUR_UTC=9

# ── Weekly admin digest (ops report) ─────────────────────────────────────────
# One platform digest a week (performance + needs-attention queues) emailed to
# the operator. The cron-digest sidecar pokes /api/cron/admin-digest daily; the
# endpoint self-gates to one send per week. ADMIN_DIGEST_URL is wired in
# docker-compose.yml, so only these need setting here:
# Recipient(s), comma-separated. Defaults to the founder address when unset.
# ADMIN_DIGEST_TO=nguemnev@gmail.com
# Base URL of the admin app for deep links in the email. Defaults to https://admin.gabee.app.
# ADMIN_APP_URL=https://admin.gabee.app
# UTC weekday the digest sends (0=Sun … 6=Sat). Defaults to 1 (Monday).
# ADMIN_DIGEST_DOW=1

# ── Observability (Sentry) — optional; unset = no error reporting (no-op) ─────
# Create a project at sentry.io (Next.js platform) and paste its DSN below.
# Same DSN value works for both; NEXT_PUBLIC_* is inlined into the browser
# bundle at BUILD time, so it must also be present as a build arg / CI var,
# not only here at runtime (see docker-compose.yml + release.yml).
# SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzz
# Build-time only — enables source-map upload for readable stack traces.
# Without these, errors still report but traces stay minified.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=gabee-web
# SENTRY_AUTH_TOKEN=sntrys_...
# Admin "System logs" page — pulls recent issues via the Sentry REST API.
# Needs SENTRY_ORG + SENTRY_PROJECT (above) plus a READ-ONLY token
# (project:read + event:read). Set SENTRY_API_BASE only if your org is on a
# region host (e.g. https://us.sentry.io); defaults to https://sentry.io.
# SENTRY_API_TOKEN=sntryu_... (or an org auth token with read scope)
# SENTRY_API_BASE=https://sentry.io
# Two stacks = two projects: list both so the logs table shows web + kid.
# Falls back to SENTRY_PROJECT (single) when unset.
# SENTRY_LOG_PROJECTS=gabee-web,gabee-kid

NODE_ENV=production
