{
  "name": "gabee",
  "version": "0.1.0",
  "private": true,
  "description": "Gabee — bilingual (FR/EN), desktop-first, offline-capable learning tool for children ~6-8 (Proxia Labs).",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:dom --filter=!@gabee/e2e",
    "test:e2e": "turbo run build && pnpm --filter @gabee/e2e run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "bash ops/security/scan.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "tsx": "^4.22.3",
    "turbo": "^2.9.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "hono@<4.12.25": ">=4.12.25"
    }
  }
}
