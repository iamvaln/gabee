{
  "name": "gabee",
  "version": "0.1.0",
  "private": true,
  "description": "Gabee — bilingual (FR/EN), desktop-first, offline-capable learning tool for children ~6-8 (Proxia Labs).",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:dom --filter=!@gabee/e2e",
    "test:e2e": "turbo run build && pnpm --filter @gabee/e2e run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "bash ops/security/scan.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "tsx": "^4.22.3",
    "turbo": "^2.9.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "tmp@<0.2.4": ">=0.2.6",
      "uuid@8.3.2": ">=11.1.1",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "esbuild@0.28.0": ">=0.28.1",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0",
      "basic-ftp@<6.2.1": "^6.2.3",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "deepmerge-ts@<8": "^8.0.2",
      "ip-address@<10.7.4": "^10.7.4",
      "js-yaml@<3.15.2": "^3.15.2",
      "mysql2@<3.23.1": "^3.24.6",
      "nanoid@<3.3.18": "^3.3.18",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs@<6.16.0": "^6.16.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici@<7.29.1": "^7.29.1",
      "valibot@<1.4.2": "^1.4.2",
      "fast-uri@<3.1.8": ">=3.1.8 <4",
      "postcss@<8.5.23": ">=8.5.23",
      "sharp@<0.35.5": ">=0.35.5",
      "hono@<4.12.34": ">=4.12.34 <5",
      "body-parser@<1.20.9": "^1.20.9",
      "serialize-javascript@<7.1.3": "^7.1.4",
      "zod@>=4 <4.6.6": "^4.6.7"
    }
  }
}
